        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup no iCloud não está mais disponível"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud yedeklemesi artık kullanılamıyor"
          }
        }
      }
    },
    "Your 2FA codes are safe. Due to reliability issues with Apple's iCloud, we've switched to the new backup — works with any drive app including Proton Drive, Dropbox, iCloud Drive and more." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine 2FA-Codes sind geschützt. Aufgrund von Zuverlässigkeitsproblemen mit Apples iCloud sind wir auf die neue Sicherungslösung umgestiegen – sie funktioniert mit jeder Speicher-App, darunter Proton Drive, Dropbox, iCloud Drive und vielen anderen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your 2FA codes are safe. Due to reliability issues with Apple's iCloud, we've switched to the new backup — works with any drive app including Proton Drive, Dropbox, iCloud Drive and more."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus códigos 2FA están seguros. Debido a problemas de fiabilidad con iCloud de Apple, hemos cambiado a la nueva copia de seguridad, funciona con cualquier aplicación de almacenamiento, incluido Proton Drive, Dropbox, iCloud, Drive y más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos codes A2F sont en sécurité. En raison de problèmes de fiabilité avec iCloud d'Apple, nous sommes passés à un nouveau système de sauvegarde, compatible avec toutes les applications de stockage en ligne, notamment Proton Drive, Dropbox, iCloud Drive et bien d'autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi codici 2FA sono al sicuro. A causa di problemi di affidabilità con iCloud di Apple, siamo passati al nuovo backup che funziona con qualsiasi app drive incluso Proton Drive, Dropbox, iCloud Drive e molte altre."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki faktörlü kimlik doğrulama kodlarınız güvende. Apple'ın iCloud hizmetindeki güvenilirlik sorunları nedeniyle yeni yedekleme yöntemine geçtik; bu yöntem Proton Drive, Dropbox, iCloud Drive ve diğer tüm Drive uygulamalarıyla uyumludur."
          }
        }
      }
    }
  },
  "version" : "1.0"
}