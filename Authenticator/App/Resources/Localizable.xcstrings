  "strings" : {
    "iCloud backup is no longer available" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-Backup ist nicht mehr verfügbar"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud backup is no longer available"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia de seguridad de iCloud ya no está disponible"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sauvegarde iCloud n'est plus disponible"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il backup iCloud non è più disponibile"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud backup is niet langer beschikbaar"
          }
