    },
    "Please go to **⋮ > Settings > Import & Export > Export**\n\nThis will create a Json file that you can use here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte gehe zu **⋮ > Einstellungen > Import & Export > Export**\n\nDadurch wird eine JSON-Datei erstellt, die du hier verwenden kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please go to **⋮ > Settings > Import & Export > Export**\n\nThis will create a Json file that you can use here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve a **Ajustes > Importar y exportar > Exportar**\n\nEsto creará un archivo Json que puedes usar aquí."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaya a **⋮ > Ajustes > Importar y Exportar > Exportar**\n\nEsto creará un archivo Json que puede usar aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez accéder les **⋮ > Paramètres > Importer et exporter > Exporter**\n\nCela créera un fichier JSON que vous pourrez utiliser ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai a **⋮Impostazioni > Importa ed Esporta > Esporta**\n\nQuesto creerà un file Json che potrai usare qui."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga naar **⋮ >Instellingen > Importeren en exporteren > Exporteren**\n\nHiermee wordt een JSON-bestand gemaakt dat u hier kunt gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesse **⋮ >Configurações > Importar e Exportar > Exportar**\n\nIsso criará um arquivo Json que você pode usar aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перейдите в **⋮ > Настройки > Импорт и экспорт > Экспорт**\n\nБудет создан Json-файл, который вы сможете использовать здесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen **⋮ > Ayarlar > İçe ve dışa aktarma > Dışa aktarma** bölümüne gidin.\n\nBöylece burada kullanabileceğiniz bir JSON dosyası oluşturabilirsiniz."
          }
        }
      }
    },
    "Please go to **⚙ > Export**\n\nThis will create a Json file that you can use here." : {
