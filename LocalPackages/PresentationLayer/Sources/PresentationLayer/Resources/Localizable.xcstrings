    "Bring your security with you.\nTransfer your data to stay protected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für mehr Sicherheit unterwegs.\nÜbertrage deine Daten, um geschützt zu bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring your security with you.\nTransfer your data to stay protected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva tu seguridad contigo.\nTransfiere tus datos para mantenerte protegido."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleve su seguridad con usted.\nTransfiera sus datos para mantenerse protegido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emportez votre sécurité avec vous.\nTransférez vos données pour rester protégé(e)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta la tua sicurezza sempre con te.\nTrasferisci i tuoi dati per garantirne la protezione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem uw beveiliging overal mee naartoe.\nZet uw gegevens over om beschermd te blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabierz swoje zabezpieczenia ze sobą.\nPrzenieś dane, aby dalej korzystać z ochrony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve a segurança com você.\nTransfira seus dados para garantir sua proteção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возьмите безопасность с собой.\\nПеренесите данные, чтобы оставаться в безопасности."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenliğinizi yanınızda taşıyın.\nKorunmak için verilerinizi aktarın."
          }
        }
      }
    },
    "Browse without being tracked and access blocked content." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surfe, ohne nachverfolgt zu werden, und greife auf blockierte Inhalte zu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browse without being tracked and access blocked content."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navega sin ser rastreado y accede a contenido bloqueado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navegue sin que le rastreen y acceda a contenidos bloqueados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naviguez sans être suivi(e) et accédez aux contenus bloqués."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naviga senza tracciamento e accedi a contenuti bloccati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browse zonder gevolgd te worden en krijg toegang tot geblokkeerde inhoud."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeglądaj bez śledzenia i uzyskaj dostęp do zablokowanych treści."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navegue livre de rastreamento e acesse conteúdo bloqueado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просматривайте без отслеживания и получайте доступ к заблокированному содержимому."
