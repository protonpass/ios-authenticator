    "Data on this device won't be updated and changes will not be reflected on other devices.\n\nYou will be logged out of your Proton account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daten auf diesem Gerät werden nicht aktualisiert und Änderungen werden nicht auf anderen Geräten übernommen.\n\nDu wirst von deinem Proton-Konto abgemeldet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data on this device won't be updated and changes will not be reflected on other devices.\n\nYou will be logged out of your Proton account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de este dispositivo no se actualizarán y los cambios no se reflejarán en otros dispositivos.\n\nSe cerrará la sesión de tu cuenta de Proton."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos en este dispositivo no se actualizarán y los cambios no se reflejarán en otros dispositivos.\n\nSe cerrará la sesión de su cuenta de Proton."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de cet appareil ne seront pas mises à jour et les modifications ne seront pas répercutées sur les autres appareils.\n\nVous serez déconnecté de votre compte Proton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati su questo dispositivo non verranno aggiornati e le modifiche non verranno applicate ad altri dispositivi.\n\nEffettuerai la disconnessione dal tuo account Proton."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gegevens op dit apparaat worden niet bijgewerkt en wijzigingen worden niet op andere apparaten doorgevoerd.\n\nU wordt uitgelogd bij uw Proton-account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane na tym urządzeniu nie będą aktualizowane, a zmiany nie pojawią się na innych urządzeniach.\n\nNastąpi wylogowanie z Twojego konta Proton."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados neste dispositivo não serão atualizados e as alterações não serão refletidas em outros dispositivos.\n\nSua conta Proton será desconectada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные на этом устройстве не будут обновляться, и изменения не отразятся на других устройствах.\n\nВы выйдете из своего аккаунта Proton."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıttaki veriler güncellenmeyecek ve değişiklikler diğer aygıtlara yansıtılmayacak.\n\nProton hesabınızdan çıkış yapacaksınız."
          }
        }
      }
    },
